#!/usr/bin/env python3
"""Delegation dispatcher: run one coding-agent CLI against the current repository.

Reads a brief on stdin, runs the requested agent CLI in the repository working tree,
and prints a structured result as JSON. Execution mechanics only - it makes no task,
model, or review decisions. Those belong to the orchestrator.

Exit status is 0 whenever a result was produced, including a failed, timed out, or
missing-CLI run; read the "status" field. Exit status 2 means the invocation itself
was wrong.
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

ROUTING = Path(__file__).resolve().parent.parent / "config" / "model-routing.json"

# Which modes each agent may run. Codex is absent from "implement" on purpose: a
# reviewer that writes the production code it reviews is not an independent reviewer.
MODES = {"opencode": ("implement",), "codex": ("review", "test", "onboard")}

# Every mode the dispatcher knows, derived from the matrix above so a new row is the only
# place a mode is declared. `--mode` accepts exactly these, and CONTRACTS and
# REPORT_DISCRIMINATORS must cover the same set.
MODE_NAMES = tuple(sorted({mode for modes in MODES.values() for mode in modes}))

# Modes whose contract has a verdict. The others deliberately have none: an onboarding
# analysis has nothing to pass or fail, and a verdict it never gave is indistinguishable
# from one it did at the point the orchestrator consumes it. Nothing in this file may
# invent a verdict for a mode that is not listed here.
VERDICT_MODES = frozenset({"review", "test"})


# --------------------------------------------------------------------------
# Delegated OpenCode permissions
#
# A delegated agent runs its own shell commands inside its own process, where the
# plugin's PreToolUse hook cannot see them. These rules are what stops a delegated
# run from crossing the same boundaries the hook enforces. They are passed through
# OPENCODE_CONFIG_CONTENT, which is the only config layer that outranks a target
# repository's own opencode.json, and they are set at both the top level and on the
# `build` agent, because agent-level permissions are resolved separately and would
# otherwise survive untouched.
#
# "*": "ask" is the base rather than "allow", so a run without --auto stalls instead
# of running anything. --auto approves asks; it cannot lift a deny.
#
# The rules are not written here. They are read from config/command-boundaries.json,
# the same file hooks/guard.py reads, and translated below into the glob patterns
# OpenCode's permission system matches on. They were two hand-maintained copies until
# the copies disagreed: a bench subcommand with no --site was denied here for four
# subcommands and asked for by the hook for seventy-six, so a delegated run had wider
# access to live sites than Claude did. One source, two translations, and a test that
# fails by rule name when either translation drops a rule.
# --------------------------------------------------------------------------

BOUNDARIES = Path(__file__).resolve().parent.parent / "config" / "command-boundaries.json"


def load_boundaries(fail):
    try:
        return json.loads(BOUNDARIES.read_text())["rules"]
    except (OSError, ValueError, KeyError, TypeError) as exc:
        # Refused, not degraded. The hook can fall back to asking because a human is
        # there to answer; nothing is watching a delegated run, so a run without its
        # permission policy is a run with no boundary at all.
        fail(
            "cannot read the command boundaries from %s: %s. Refusing to delegate - "
            "these rules are what holds a delegated run inside the same boundaries the "
            "hook enforces, and nothing else applies them." % (BOUNDARIES, exc)
        )


def rule_patterns(rule):
    """One boundary rule -> the OpenCode bash patterns that express it.

    Glob translation lives here because it is this engine's mechanics, not the rule.
    The one subtlety worth stating: a trailing `*` is safe after an option but not
    after a path, so `git add .` expands to the exact command and `git add . *`,
    never to `git add .*`, which would also deny `git add .gitignore` - staging one
    dotfile by name is the correct thing this rule exists to leave alone.
    """
    match = rule["match"]
    kind = match.get("kind")

    if kind == "program":
        return ["%s*" % name for name in match["programs"]]

    program = match.get("program")

    if kind == "program_option":
        return [
            form % (program, option)
            for option in match["options"]
            for form in ("%s %s*", "%s * %s*")
        ]

    if kind == "program_subcommand":
        patterns = []
        for sub in match["subcommands"]:
            prefixes = ["%s %s" % (program, sub), "%s * %s" % (program, sub)]
            arguments = match.get("any_argument")
            if not arguments:
                patterns += ["%s*" % prefix for prefix in prefixes]
                continue
            for argument in arguments:
                for prefix in prefixes:
                    if argument.startswith("-"):
                        patterns.append("%s %s*" % (prefix, argument))
                    else:
                        patterns += [
                            "%s %s" % (prefix, argument),
                            "%s %s *" % (prefix, argument),
                            "%s -- %s" % (prefix, argument),
                            "%s -- %s *" % (prefix, argument),
                        ]
        return patterns

    return []   # a kind this consumer does not implement; the suite fails by rule name


def denied_bash(rules):
    """Every pattern denied inside a delegated run, from the shared boundary data."""
    patterns = []
    for rule in rules:
        if rule.get("delegated") == "deny":
            patterns += rule_patterns(rule)
    return patterns


def opencode_permissions(rules):
    """Permission config for a delegated OpenCode run, as a JSON-ready dict."""
    bash = {"*": "ask"}
    bash.update({pattern: "deny" for pattern in denied_bash(rules)})
    block = {"bash": bash}
    return {"permission": block, "agent": {"build": {"permission": block}}}


# --------------------------------------------------------------------------
# Output contracts
#
# Appended to every brief by the dispatcher rather than left to the caller, so the
# result contract holds even when the orchestrator forgets to ask for it.
# --------------------------------------------------------------------------

_TAIL = """End your reply with exactly one fenced JSON block and nothing after it:

```json
%s
```
"""

CONTRACTS = {
    "implement": """## Requested output

Make the change in the repository working tree. Read the files you need directly;
do not ask for them to be pasted.

"""
    + _TAIL
    % json.dumps(
        {
            "status": "completed | incomplete",
            "summary": "<two sentences at most>",
            "touched_files": ["<repository-relative path>"],
            "commands_run": ["<command>"],
            "tests_run": ["<command>"],
            "warnings": ["<anything the orchestrator should know>"],
        },
        indent=2,
    )
    + """
"completed" means your execution finished. It does not mean the change is correct -
an independent reviewer decides that. Report what you actually did, including work
you could not finish.
""",
    "review": """## Requested output

You are reviewing, not implementing. Do not modify production code. Inspect the
actual diff and the affected code, run the tests that the change actually warrants,
and report what you find.

Use "blocking" only for findings that must be fixed before this can be committed:
incorrect behaviour, regression, failing required test, data corruption risk,
permission problem, missing required behaviour, unsafe implementation. Everything
else is "non_blocking" and will not trigger rework.

Return BLOCKED, not FAIL, when verification could not be completed reliably - a
missing dependency, an unavailable service, a broken test environment. BLOCKED is
not a verdict on the implementation.

"""
    + _TAIL
    % json.dumps(
        {
            "verdict": "PASS | FAIL | BLOCKED",
            "blocker_reason": "<only when BLOCKED>",
            "summary": "<two sentences at most>",
            "findings": [
                {
                    "category": "blocking | non_blocking",
                    "file": "<repository-relative path>",
                    "detail": "<what is wrong and why it matters>",
                }
            ],
            "tests_run": ["<command>"],
            "missing_coverage": ["<behaviour a test should protect but none does>"],
        },
        indent=2,
    ),
    "test": """## Requested output

You may create or modify test files only. Do not modify production code; if the fix
belongs in production code, say so in a finding instead of making it.

Write the smallest tests that establish whether the behaviour under review is
correct, run them, and report the outcome.

"""
    + _TAIL
    % json.dumps(
        {
            "verdict": "PASS | FAIL | BLOCKED",
            "blocker_reason": "<only when BLOCKED>",
            "summary": "<two sentences at most>",
            "findings": [
                {
                    "category": "blocking | non_blocking",
                    "file": "<repository-relative path>",
                    "detail": "<what is wrong and why it matters>",
                }
            ],
            "tests_added": ["<repository-relative path>"],
            "tests_run": ["<command>"],
        },
        indent=2,
    ),
    "onboard": """## Requested output

You are analysing this repository so that its structure can be documented. There is no
diff and nothing to judge here: do not review the code, do not rate its quality, and do
not modify anything.

Establish the project type, the major directories, the entry points, configuration,
dependencies, tests, the architecture boundaries, and the areas carrying the important
business behaviour. Read only the code needed to establish those; do not read the
repository exhaustively.

Reading the repository is the whole task. Do not run the project's test suite, and do not
execute anything against a database, a site, or a running instance of the application - a
command that needs a live service is out of scope here even when it looks like the
quickest way to settle a question. Answer from the repository or record the question as
unsettled.

Every finding must be checkable against a path you actually read. Anything the repository
did not settle belongs in "uncertain", not in a finding. An assumption reported as a fact
is worse here than an admitted gap, because what you return is written into the project's
own documentation and later tasks are planned from it.

This contract has no verdict field. Report what you found.

"""
    + _TAIL
    % json.dumps(
        {
            "analysis": "complete | partial",
            "not_analysed": ["<area you did not reach; only when partial>"],
            "summary": "<two sentences at most>",
            "findings": [
                {
                    "area": "project | architecture | operations",
                    "detail": "<what is there, stated so it can be verified>",
                    "evidence": ["<repository-relative path you read>"],
                }
            ],
            "uncertain": ["<something the repository did not settle>"],
        },
        indent=2,
    )
    + """
"analysis" describes your own coverage, not the state of the project. "complete" means you
established the areas listed above; "partial" means you did not, and "not_analysed" says
which ones. Neither value is a judgement on the repository, and neither is a pass or a
fail.

"findings" carries the substance. An analysis that produced none is a real outcome and is
reported as such, not as a failure.

"area" says which part of the project documentation a finding belongs to: orientation
("project"), change impact ("architecture"), or how to run, test and verify
("operations").
""",
}


# --------------------------------------------------------------------------
# Adapters - the only agent-specific code in this file.
# Each returns (argv, env, stdin_text). stdin_text is None when the brief is
# delivered as an argument instead.
# --------------------------------------------------------------------------


def adapt_opencode(*, brief, model_id, effort, mode, cwd, rules=()):
    # --dir, not the process working directory. Setting the child's cwd is not enough:
    # OpenCode resolved its working directory from the inherited PWD instead, so a run
    # launched from one repository with --cwd pointing at another operated on the first
    # one - reading, writing and running git in a repository the dispatcher had not been
    # asked to touch, while reporting the one it had. PWD is set to match as well, so
    # nothing further down inherits a directory that disagrees with the process.
    argv = [
        "opencode", "run", "--agent", "build", "--auto",
        "--dir", cwd, "--model", model_id,
    ]
    if effort:
        argv += ["--variant", effort]
    argv.append(brief)
    env = dict(os.environ)
    env["OPENCODE_CONFIG_CONTENT"] = json.dumps(opencode_permissions(rules))
    env["PWD"] = cwd
    # A Linux opencode reads OPENCODE_CONFIG_CONTENT from the environment directly, and
    # measurement says so: with WSLENV unset, the resolved config is this policy - 173
    # bash rules, base "*": "ask", no allow - and the hostile project config contributes
    # nothing. WSLENV is not what makes delivery work here.
    #
    # It stays anyway, for the build this dispatcher does not choose. WSL hands a variable
    # to a *Windows* process only if WSLENV names it, and without that the policy is not
    # weakened but absent: zero bash rules, not even the "*": "ask" base, after which
    # --auto approves everything. That is not hypothetical - a delegated run executed
    # `bench migrate` unrefused - and a Windows opencode is still on PATH one position
    # behind the Linux one on the machine this was measured on. Which one `opencode`
    # resolves to is a property of PATH, which nothing here controls, so the line is kept
    # unconditional rather than made to depend on a guess about the build. It is inert
    # when the CLI is a Linux process, and `agent_path` in the result records which one
    # actually ran.
    #
    # /w is the direction that matters here (WSL -> Win32); /u is the opposite one and
    # does nothing for this. No path translation: the value is JSON, and /p would mangle
    # it. Already-named is left alone so a nested run does not repeat the entry.
    existing = env.get("WSLENV")
    if "OPENCODE_CONFIG_CONTENT/" not in (existing or ""):
        env["WSLENV"] = (
            "%s:OPENCODE_CONFIG_CONTENT/w" % existing if existing
            else "OPENCODE_CONFIG_CONTENT/w"
        )
    return argv, env, None


def adapt_codex(*, brief, mode, cwd, **_):
    # Both sandboxes execute model-generated shell commands - the CLI's own help for
    # --sandbox says so. What they restrict is reach: read-only permits no write and no
    # network, workspace-write confines writes to the working tree and still has no
    # network, so TEST mode can add tests and run them but cannot reach a remote.
    #
    # The condition names the one mode that needs to write, so a mode added later gets
    # read-only by default rather than write access by omission. This is the layer that
    # holds a delegated Codex run inside the boundary - see the OpenCode permission note
    # above for the same argument on the other agent - and a new mode silently landing on
    # the write side of an `if mode == "review"` test is exactly how that would lapse.
    sandbox = "workspace-write" if mode == "test" else "read-only"
    # -C for the same reason --dir is passed to OpenCode. Codex was verified to honour the
    # process working directory correctly, unlike OpenCode, but a directory this important
    # is stated rather than inherited: the failure is silent and the run looks normal.
    env = dict(os.environ)
    env["PWD"] = cwd
    return ["codex", "exec", "--sandbox", sandbox, "-C", cwd, "-"], env, brief


ADAPTERS = {"opencode": adapt_opencode, "codex": adapt_codex}


# --------------------------------------------------------------------------
# Routing lookup
# --------------------------------------------------------------------------


def load_routing(fail):
    try:
        return json.loads(ROUTING.read_text())
    except (OSError, ValueError) as exc:
        fail("cannot read %s: %s" % (ROUTING, exc))


def resolve_model(routing, name, fail):
    """Display name -> provider CLI id, refusing anything not delegable."""
    models = routing.get("models") or {}
    entry = models.get(name)
    if entry is None:
        fail(
            'unknown model "%s". Names in %s: %s'
            % (name, ROUTING, ", ".join(sorted(models)) or "none")
        )
    executor = entry.get("executor")
    if executor != "opencode":
        fail(
            '"%s" has executor "%s" in the routing file, not "opencode". Claude '
            "implements that tier directly with its own access, then delegates the "
            "review to Codex. Do not delegate it to OpenCode." % (name, executor)
        )
    model_id = entry.get("id")
    if not model_id or (model_id.startswith("<") and model_id.endswith(">")):
        fail(
            '"%s" has no provider CLI id in %s (found %r). Fill it in before '
            "delegating to this model." % (name, ROUTING, model_id)
        )
    return model_id


# --------------------------------------------------------------------------
# Working directory
#
# Never inherited, never defaulted, always validated. OpenCode resolved its working
# directory from the environment rather than from the process it was given, so an omitted
# --cwd did not mean "here" - it meant "wherever the orchestrator's shell happened to be",
# while the result reported something else. A directory chosen by accident is the failure
# this refuses; naming the wrong repository on purpose is still possible and is not what
# this is for.
# --------------------------------------------------------------------------

CWD_REQUIRED = (
    "--cwd is required and is never inferred. The directory a delegated run works in is "
    "not inherited from this process: OpenCode resolves it from the environment, so an "
    "omitted --cwd means whichever directory the caller's shell was in, and the result "
    "would report a directory the agent never touched. Pass the repository root."
)


def enclosing_repository(path):
    """Nearest ancestor of `path` that is a git work tree root, or None."""
    current = path
    while True:
        parent = os.path.dirname(current)
        if parent == current:  # filesystem root
            return None
        current = parent
        if os.path.exists(os.path.join(current, ".git")):
            return current


def resolve_working_directory(raw, fail):
    """--cwd -> an absolute, symlink-resolved git work tree root.

    A subdirectory of a repository is refused rather than resolved upward. Resolving it
    would hand the agent a wider scope than the caller named, silently - the same shape of
    quiet substitution that made the inherited-directory defect survive. The error names
    the root, so correcting it is one edit.

    `.git` is tested for as a path rather than by running git: a work tree added with
    `git worktree add` has it as a file, a normal clone as a directory, and a bare
    repository has neither, which is correctly refused - there is no work tree to edit.
    """
    if raw is None:
        fail(CWD_REQUIRED)
    path = os.path.realpath(os.path.expanduser(raw))
    if not os.path.isdir(path):
        fail("--cwd is not a directory: %s" % path)
    if not os.path.exists(os.path.join(path, ".git")):
        root = enclosing_repository(path)
        if root:
            fail(
                "--cwd must be a repository root, and %s is a subdirectory of %s. It is "
                "not resolved upward for you: a delegated run given a wider scope than "
                "the one named is how the wrong tree gets edited quietly. Pass %s."
                % (path, root, root)
            )
        fail(
            "--cwd is not a git work tree: %s contains no .git. A delegated run is "
            "scoped to one repository, and this is not one." % path
        )
    return path


# --------------------------------------------------------------------------
# Execution
# --------------------------------------------------------------------------


def resolve_program(name, env):
    """Which file the CLI name resolves to -> (path on PATH, symlinks followed), or None.

    Recorded in the result because a CLI name is not a build. On the machine this plugin
    was developed against, `opencode` is a Linux binary in nvm's bin directory and a
    Windows shim under /mnt/c is second on PATH; they behave differently enough that a
    result measured against one says little about the other - the Windows build did not
    receive the permission policy at all, and ran a delegated `bench migrate` unrefused.
    PATH order is not this dispatcher's to control, and a change to it is silent. Writing
    the resolved path into every result makes a run measured against the wrong build
    visible in the record rather than inferred from it afterwards.

    Both forms are kept: PATH resolution is what determines which program runs, and the
    real path is what identifies it. Neither alone is enough - nvm's `opencode` is a
    symlink, and the file it points at is named `opencode.exe` while being an ELF
    executable, so the name settles nothing and the directory settles it.

    PATH is read from the child's environment, not this process's, so what is recorded is
    what the child will actually resolve.
    """
    found = shutil.which(name, path=env.get("PATH"))
    return (found, os.path.realpath(found)) if found else None


def execute(argv, env, stdin_text, cwd, timeout):
    """Run the CLI. Returns (status, exit_code, stdout, stderr, seconds)."""
    started = time.monotonic()
    try:
        proc = subprocess.Popen(
            argv,
            cwd=cwd,
            env=env,
            stdin=subprocess.PIPE if stdin_text is not None else subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
    except OSError as exc:
        return "error", None, "", str(exc), time.monotonic() - started

    try:
        out, err = proc.communicate(input=stdin_text, timeout=timeout)
        status = "completed" if proc.returncode == 0 else "failed"
    except subprocess.TimeoutExpired:
        proc.kill()
        out, err = proc.communicate()
        status = "timeout"
    return status, proc.returncode, out, err, time.monotonic() - started


# What identifies a report is the contract this dispatcher itself appended to the brief,
# so identification uses that rather than a guess about which keys look report-shaped.
# Each mode has one discriminating field with an enumerated value; CLI chatter such as
# {"status": "connected", "summary": "..."} carries neither.
REPORT_DISCRIMINATORS = {
    "implement": ("status", frozenset({"completed", "incomplete"})),
    "review": ("verdict", frozenset({"pass", "fail", "blocked"})),
    "test": ("verdict", frozenset({"pass", "fail", "blocked"})),
    "onboard": ("analysis", frozenset({"complete", "partial"})),
}

# Bounds on untrusted output. Parsing happens after the CLI has exited, so the process
# timeout does not cover it, and all three limits fail closed: the report is reported
# missing rather than the dispatcher hanging.
MAX_DECODE_ATTEMPTS = 20000  # candidates considered
MAX_SCAN_SECONDS = 5.0  # cumulative decoding, which candidate count alone does not bound
MAX_REPORT_CHARS = 200000  # per-candidate slice; a real report is a few KB


def _is_report(obj, mode):
    key, allowed = REPORT_DISCRIMINATORS[mode]
    value = obj.get(key)
    return isinstance(value, str) and value.strip().casefold() in allowed


def _reports(text, mode):
    """Report objects in `text`, scanned from the end."""
    decoder = json.JSONDecoder()
    deadline = time.monotonic() + MAX_SCAN_SECONDS
    index = len(text)
    for _ in range(MAX_DECODE_ATTEMPTS):
        start = text.rfind("{", 0, index)
        if start == -1 or time.monotonic() > deadline:
            return
        index = start
        try:
            parsed, _end = decoder.raw_decode(text[start:start + MAX_REPORT_CHARS], 0)
        except (ValueError, RecursionError):
            # Malformed here, or nested past the interpreter's stack limit. Neither is
            # the dispatcher's problem: keep scanning.
            continue
        if isinstance(parsed, dict) and _is_report(parsed, mode):
            yield parsed


# Keys that carry a verdict. In a mode whose contract has none, an agent that volunteers
# one is producing exactly the artefact this separation exists to prevent, so it is
# removed rather than passed through.
VERDICT_KEYS = ("verdict", "blocker_reason")


def strip_off_contract(report, mode):
    """Remove volunteered verdict keys from a report in a mode that has no verdict.

    Returns the keys removed, in order, so the caller can record them.

    An agent writes what it writes. A mode without a verdict cannot stop one appearing in
    the agent's JSON - it can only refuse to hand it on as though the contract had asked
    for it. A verdict nobody asked for is indistinguishable, at the point the orchestrator
    reads `agent_report`, from one a reviewer actually reached; that is the whole reason
    these modes have no verdict field. Removing it loses nothing that was ever asked for,
    and the rest of the report stays intact because the analysis is still the product.
    """
    if report is None or mode in VERDICT_MODES:
        return []
    removed = [key for key in VERDICT_KEYS if key in report]
    for key in removed:
        del report[key]
    return removed


def extract_report(text, mode):
    """Find the agent's result object in its output -> (state, parsed or None).

    Located structurally, never by position and never by recognising a CLI's wording.
    Agent CLIs wrap their output in banners, prompt echoes, and token footers whose text
    changes between versions, so nothing here may depend on that text.

    Fences are deliberately not parsed. A real report contained a fenced example inside
    one of its own strings, and any regex delimiting a block on ``` truncates the body at
    that inner fence. Brace balancing has no such failure: the decoder consumes strings
    correctly, whatever they contain.

    The scan runs backwards and stops at the first object that satisfies the mode's
    contract, so the agent's own answer wins over anything a CLI printed before it, and a
    nested report is found rather than skipped along with its wrapper.

    This reads untrusted output, so it must not raise, must not hang, and must not pass
    off a CLI's own JSON as something the agent wrote. Decoding failures are therefore
    swallowed, the scan is bounded three ways, and a report is recognised by the
    contract's own enumerated value rather than by looking plausible.

    "invalid" means no report was found but a fence appears somewhere, so the agent tried
    and the answer was unusable. Without one there is nothing to salvage: "missing".
    """
    text = text or ""
    for report in _reports(text, mode):
        return "present", report
    return ("invalid" if "```" in text else "missing"), None


# --------------------------------------------------------------------------
# CLI
# --------------------------------------------------------------------------


# --------------------------------------------------------------------------
# The invocation
#
# Three places outside this file tell someone how to call the dispatcher: the hook's
# deny reason, which a blocked agent reads instead of running the CLI itself; the
# orchestration skill, which is what Claude follows; and this module's own --help.
# None of them can be generated from here - the hook is a separate process with no
# reason to import this one, and the skill is prose - so all three are copies, and a
# mode added to MODES updates none of them.
#
# What follows is therefore arranged to be checkable rather than merely correct. The
# parser is built by a function so the suite can ask it which arguments are required,
# and the combination rules are a function so the suite can run every invocation the
# skill documents through the same code a real run goes through. The copies stay
# hand-written; what is enforced is that they still describe this.
# --------------------------------------------------------------------------


def build_parser():
    parser = argparse.ArgumentParser(
        prog="delegate",
        description="Run one coding-agent CLI against the current repository. "
        "The brief is read from stdin.",
    )
    parser.add_argument("--agent", required=True, choices=sorted(MODES))
    parser.add_argument("--mode", required=True, choices=MODE_NAMES)
    parser.add_argument(
        "--tier", required=True, choices=("FAST", "SMALL", "NORMAL", "DIFFICULT")
    )
    parser.add_argument("--model", help="display name from the routing file")
    parser.add_argument(
        "--effort",
        help="defaults to the tier's effort; pass an empty string to omit --variant",
    )
    parser.add_argument(
        "--cwd",
        help="required: the repository root the run works in, never inherited",
    )
    parser.add_argument("--timeout", type=int, help="defaults to the tier's timeout")
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="print the command that would run, and do not run it",
    )
    return parser


# Required, but not by the parser: resolve_working_directory refuses an absent --cwd with
# an explanation argparse has no room for. Named here so "the required arguments" is a
# question this file answers, rather than one three copies each answer from memory.
REQUIRED_OUTSIDE_PARSER = ("--cwd",)


def validate_invocation(agent, mode, model, fail):
    """Reject an agent/mode/model combination the dispatcher does not support."""
    if mode not in MODES[agent]:
        if agent == "codex" and mode == "implement":
            fail(
                "Codex does not implement. It reviews the production code it did not "
                "write, which is what makes the review independent. Delegate "
                "implementation to OpenCode, or implement it directly when the "
                "routing file gives that model executor \"claude\"."
            )
        fail(
            "--agent %s supports --mode %s"
            % (agent, " or ".join(MODES[agent]))
        )
    if agent == "opencode":
        if not model:
            fail("--model is required for --agent opencode")
    elif model:
        fail(
            "--model is not accepted for --agent %s; %s is not pinned to a model and "
            "uses its own CLI default." % (agent, agent.capitalize())
        )


def main():
    parser = build_parser()
    args = parser.parse_args()
    fail = parser.error  # exits 2

    validate_invocation(args.agent, args.mode, args.model, fail)

    routing = load_routing(fail)
    boundaries = load_boundaries(fail)

    tier = (routing.get("tiers") or {}).get(args.tier)
    if tier is None:
        fail('tier "%s" is not in %s' % (args.tier, ROUTING))
    timeout = args.timeout or tier.get("timeout_seconds")
    if not timeout:
        fail('tier "%s" has no timeout_seconds in %s' % (args.tier, ROUTING))

    if args.agent == "opencode":
        model_id = resolve_model(routing, args.model, fail)
        effort = args.effort if args.effort is not None else tier.get("effort")
    else:
        model_id, effort = None, None

    brief = "" if sys.stdin.isatty() else sys.stdin.read()
    if not brief.strip():
        if not args.dry_run:
            fail("the brief is read from stdin and was empty")
        brief = "(dry run: no brief supplied)"

    cwd = resolve_working_directory(args.cwd, fail)

    # The leading heading also guarantees the brief never starts with "-" when it is
    # passed as a positional argument.
    full_brief = "# Delegated task (%s)\n\n%s\n\n%s" % (
        args.mode,
        brief.strip(),
        CONTRACTS[args.mode],
    )

    argv, env, stdin_text = ADAPTERS[args.agent](
        brief=full_brief, model_id=model_id, effort=effort, mode=args.mode, cwd=cwd,
        rules=boundaries,
    )

    if args.dry_run:
        executable = resolve_program(argv[0], env)
        json.dump(
            {
                "dry_run": True,
                "argv": argv,
                "cwd": cwd,
                "agent_path": executable[0] if executable else None,
                "agent_real_path": executable[1] if executable else None,
                "timeout_seconds": timeout,
                "stdin": "brief" if stdin_text is not None else None,
                "env_overrides": {
                    k: v
                    for k, v in env.items()
                    if k in ("OPENCODE_CONFIG_CONTENT", "PWD", "WSLENV")
                },
            },
            sys.stdout,
            indent=2,
        )
        print()
        return

    # Outside the repository, so delegation artifacts never reach the working tree.
    workspace = Path(tempfile.mkdtemp(prefix="delegate-%s-%s-" % (args.agent, args.mode)))
    (workspace / "brief.md").write_text(full_brief)
    # Echoed early so the workspace is recoverable if this process is killed.
    print("workspace: %s" % workspace, file=sys.stderr)

    executable = resolve_program(argv[0], env)
    if executable is None:
        status, code, out, err, seconds = "cli_missing", None, "", "", 0.0
    else:
        status, code, out, err, seconds = execute(argv, env, stdin_text, cwd, timeout)

    (workspace / "agent-output.txt").write_text(out)
    (workspace / "agent-stderr.txt").write_text(err)
    block_state, report = extract_report(out, args.mode)
    off_contract = strip_off_contract(report, args.mode)

    # --variant is the only argument this dispatcher passes whose accepted values are
    # not verified against the CLI; they are provider-specific. A CLI that rejects an
    # argument exits before producing any output, so that combination is reported as a
    # usage error rather than a generic failure - otherwise the cause is invisible.
    if status == "failed" and not out.strip() and "--variant" in argv:
        status = "usage_error"

    result = {
        "status": status,
        "agent": args.agent,
        "mode": args.mode,
        "tier": args.tier,
        "model": args.model,
        "model_id": model_id,
        "effort": effort,
        "exit_code": code,
        "duration_seconds": round(seconds, 1),
        "timeout_seconds": timeout,
        "cwd": cwd,
        "agent_path": executable[0] if executable else None,
        "agent_real_path": executable[1] if executable else None,
        "workspace": str(workspace),
        "transcript": str(workspace / "agent-output.txt"),
        "result_block": block_state,
        "off_contract_keys": off_contract,
        "agent_report": report,
    }

    if status == "cli_missing":
        result["error"] = (
            "%s is not installed or not on PATH. Nothing was run." % argv[0]
        )
    elif status == "usage_error":
        result["error"] = (
            "%s exited %s before producing any output, which is how a CLI reports a "
            "rejected argument. The only argument here whose accepted values are "
            "unverified is `--variant %s`, taken from the tier's effort in the routing "
            "file; variant names are provider-specific. Re-run with --effort '' to drop "
            "it. If that succeeds, the variant value is the cause; if it fails the same "
            "way, look at the stderr below. CLI stderr: %s"
            % (argv[0], code, effort, err.strip()[:800] or "(empty)")
        )
    elif status == "error":
        result["error"] = err
    elif status == "timeout":
        # A timeout is a blocker, not a verdict on the implementation.
        result["blocker_reason"] = "timeout"
        if args.mode in VERDICT_MODES:
            result["verdict"] = "BLOCKED"

    (workspace / "result.json").write_text(json.dumps(result, indent=2) + "\n")
    json.dump(result, sys.stdout, indent=2)
    print()


if __name__ == "__main__":
    main()
