def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("collect", help="print one day's commits as JSON")
    p.add_argument("--date", help="YYYY-MM-DD in local time (default: today)")
    p.add_argument("--head-only", action="store_true",
                   help="only commits reachable from HEAD, not every local branch")
    p.set_defaults(func=collect)

    p = sub.add_parser("render", help="lay out the Arabic content as a PDF")
    p.add_argument("content", help="JSON file with the Arabic report content")
    p.add_argument("--commits", required=True, help="the JSON `collect` printed")
    p.add_argument("--out", help="PDF path (default: <repo>/reports/<date>-...-ar.pdf)")
    p.add_argument("--html", help="also write the intermediate HTML here")
    p.add_argument("--previews", help="write a PNG of each page into this directory")
    p.set_defaults(func=render)

    p = sub.add_parser("verify", help="check an existing report PDF")
    p.add_argument("path")
    p.add_argument("--previews", help="write a PNG of each page into this directory")
    p.set_defaults(func=verify)

    args = parser.parse_args()
    try:
        args.func(args)
    except UsageError as exc:
        print("dev-report: %s" % exc, file=sys.stderr)
        return 2
    except Failure as exc:
        print("dev-report: %s" % exc, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
