{
  "description": "Enforces the push, staging, and live-site boundaries whether or not the orchestration skill loaded. PostToolUse records a protected site as approved for the session once a command the user approved has actually run.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/guard.py",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/guard.py",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
